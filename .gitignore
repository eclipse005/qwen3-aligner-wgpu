# local build output
/target/

# checkpoints and audio: fetched, not committed
/models/
*.wav

# the frozen reference: this machine's dumps of the Python run it is gated
# against (6 clips x {fp32,f16,bf16}).  Regenerate with the gold generator; the
# numbers only mean anything with the same checkpoint hash, which the files
# record.
/tools/gold/

# activation dumps for the value-level comparison against torch (about 1 GB for
# the two longest clips; regenerate with QALIGN_DUMP_LAYERS / QALIGN_DUMP_HEAD
# and `D:\Qwen3-ASR\dump_ref_intermediates.py`)
/tools/dump/

# bench harness output (regenerate with scripts/bench.ps1)
/scripts/bench-*.tsv
/scripts/*.log

# the measured-performance records -- this machine's numbers, kept out of the
# published tree
/docs/
/HANDOFF.md

# local dev tooling: this machine's instruments, kept out of the published tree.
# The bench/gate scripts and the FMA-wall probe are how the numbers in
# docs/perf.md were produced, and none of them ship.
/scripts/*.ps1
/examples/

# python bytecode, if any tooling is dropped in later
__pycache__/
*.pyc

# Command Code session state (taste memory, session logs)
/.commandcode/
